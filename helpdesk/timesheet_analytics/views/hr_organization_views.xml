<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_organization_tree" model="ir.ui.view">
            <field name="name">hr.organization.tree</field>
            <field name="model">hr.organization</field>
            <field name="arch" type="xml">
                <list string="Organizations">
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_hr_organization_form" model="ir.ui.view">
            <field name="name">hr.organization.form</field>
            <field name="model">hr.organization</field>
            <field name="arch" type="xml">
                <form string="Organization">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_organization_search" model="ir.ui.view">
            <field name="name">hr.organization.search</field>
            <field name="model">hr.organization</field>
            <field name="arch" type="xml">
                <search string="Organizations">
                    <field name="name"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="hr_organization_action" model="ir.actions.act_window">
            <field name="name">Organizations</field>
            <field name="res_model">hr.organization</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_hr_organization_search"/>
            <field name="context">{}</field>
        </record>

        <menuitem
            id="menu_hr_organization"
            name="Organizations"
            parent="hr.menu_config_employee"
            action="hr_organization_action"
            sequence="8"
            groups="hr.group_hr_user"/>
    </data>
</odoo>
