<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_helpdesk_team_customer_form" model="ir.ui.view">
        <field name="name">view.helpdesk.team.customer.form</field>
        <field name="model">helpdesk.ticket.team</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_team_form" />
        <field name="arch" type="xml">
            <field name="show_in_portal" position="before">
                <field name="customer_id"
                       options="{'no_create': True}"
                       groups="helpdesk_mgmt.group_helpdesk_manager" />
                <field name="is_dedicated_team" invisible="1" />
            </field>
        </field>
    </record>
</odoo>
