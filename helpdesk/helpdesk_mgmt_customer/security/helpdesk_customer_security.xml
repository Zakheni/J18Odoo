<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Portal users can only see their own customer's tickets -->
        <record id="helpdesk_ticket_customer_portal_rule" model="ir.rule">
            <field name="name">Helpdesk Ticket: Portal Customer Isolation</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
            <field name="global" eval="True" />
            <field name="domain_force">[
                '|',
                ('partner_id', 'child_of', [user.commercial_partner_id.id]),
                ('message_partner_ids', 'child_of', [user.commercial_partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        </record>

        <!-- Portal users can read only their customer config -->
        <record id="helpdesk_customer_portal_rule" model="ir.rule">
            <field name="name">Helpdesk Customer: Portal Access</field>
            <field name="model_id" ref="model_helpdesk_customer" />
            <field name="global" eval="True" />
            <field name="domain_force">[
                ('partner_id', 'child_of', [user.commercial_partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        </record>

        <!-- Company isolation for customer records -->
        <record id="helpdesk_customer_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Customer: Company Rule</field>
            <field name="model_id" ref="model_helpdesk_customer" />
            <field name="global" eval="True" />
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
