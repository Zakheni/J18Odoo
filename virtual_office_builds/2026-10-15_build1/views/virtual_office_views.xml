<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_virtual_office_tree" model="ir.ui.view">
        <field name="name">virtual.office.tree</field>
        <field name="model">virtual.office</field>
        <field name="arch" type="xml">
            <list string="Offices">
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="room_count"/>
                <field name="online_count"/>
                <field name="state" widget="badge" decoration-success="state == 'open'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_virtual_office_kanban" model="ir.ui.view">
        <field name="name">virtual.office.kanban</field>
        <field name="model">virtual.office</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="brand_color"/>
                <field name="online_count"/>
                <field name="room_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image" t-attf-style="background:#{record.brand_color.raw_value or '#7C4DFF'}22;">
                                <i class="fa fa-building-o fa-3x" title="Office" t-attf-style="color:#{record.brand_color.raw_value or '#7C4DFF'};"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><i class="fa fa-users" title="Online"/> <field name="online_count"/> online</div>
                                <div><i class="fa fa-th-large" title="Rooms"/> <field name="room_count"/> rooms</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_virtual_office_form" model="ir.ui.view">
        <field name="name">virtual.office.form</field>
        <field name="model">virtual.office</field>
        <field name="arch" type="xml">
            <form string="Office">
                <header>
                    <button name="action_open_office" type="object" string="Open Office"
                            class="oe_highlight" icon="fa-external-link"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_office"
                                icon="fa-sign-in">
                            <div class="o_stat_info"><span class="o_stat_text">Enter</span></div>
                        </button>
                        <button class="oe_stat_button" name="%(action_virtual_room)d" type="action"
                                icon="fa-th-large"
                                context="{'search_default_office_id': id}">
                            <field name="room_count" widget="statinfo" string="Rooms"/>
                        </button>
                        <button class="oe_stat_button" name="%(action_virtual_attendee)d" type="action"
                                icon="fa-user"
                                context="{'search_default_office_id': id, 'search_default_online': 1}">
                            <field name="online_count" widget="statinfo" string="Online"/>
                        </button>
                        <button class="oe_stat_button" name="%(action_virtual_guest_pass)d" type="action"
                                icon="fa-id-card-o"
                                context="{'search_default_office_id': id}"
                                invisible="not is_public">
                            <field name="guest_count" widget="statinfo" string="Guests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Headquarters"/></h1>
                        <h3 class="text-muted"><field name="code" placeholder="url-slug"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_public"/>
                            <field name="attendance_enabled"/>
                            <field name="max_attendees"/>
                        </group>
                        <group>
                            <field name="join_url" widget="CopyClipboardChar" readonly="1"
                                   invisible="not id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rooms" name="rooms">
                            <field name="room_ids" context="{'default_office_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="room_type"/>
                                    <field name="capacity"/>
                                    <field name="occupancy"/>
                                    <field name="is_private"/>
                                </list>
                            </field>
                        </page>
                        <page string="Layout" name="layout">
                            <group>
                                <group string="Floor">
                                    <field name="floor_width"/>
                                    <field name="floor_depth"/>
                                    <field name="theme"/>
                                    <field name="brand_color" widget="color"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                Room positions and sizes are edited on each room
                                (X/Y in metres, centre-anchored). The 3D client lays
                                the floor out from these values.
                            </div>
                        </page>
                        <page string="Members" name="members">
                            <field name="member_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="Guest Passes" name="guests" invisible="not is_public">
                            <field name="guest_pass_ids" context="{'default_office_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="valid_to"/>
                                    <field name="use_count"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="What is this office for?"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_virtual_office_search" model="ir.ui.view">
        <field name="name">virtual.office.search</field>
        <field name="model">virtual.office</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <filter name="filter_open" string="Open" domain="[('state','=','open')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
