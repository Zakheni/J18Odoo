<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="office_headquarters" model="virtual.office" context="{'virt_office_skip_lobby': True}">
            <field name="name">Headquarters</field>
            <field name="code">headquarters</field>
            <field name="description">The main virtual office. Walk around, drop into a room and talk to whoever is there - no scheduling, no links.</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="floor_width">24</field>
            <field name="floor_depth">18</field>
            <field name="theme">light</field>
            <field name="brand_color">#7C4DFF</field>
            <field name="max_attendees">25</field>
            <field name="is_public" eval="True"/>
        </record>

        <record id="room_lobby" model="virtual.room">
            <field name="name">Lobby</field>
            <field name="office_id" ref="office_headquarters"/>
            <field name="room_type">lounge</field>
            <field name="sequence">1</field>
            <field name="capacity">12</field>
            <field name="pos_x">-7</field>
            <field name="pos_y">-5</field>
            <field name="width">8</field>
            <field name="depth">6</field>
            <field name="color">#7C4DFF</field>
        </record>

        <record id="room_open_space" model="virtual.room">
            <field name="name">Open Space</field>
            <field name="office_id" ref="office_headquarters"/>
            <field name="room_type">open_space</field>
            <field name="sequence">2</field>
            <field name="capacity">16</field>
            <field name="pos_x">2</field>
            <field name="pos_y">-5</field>
            <field name="width">12</field>
            <field name="depth">6</field>
            <field name="color">#4A90D9</field>
        </record>

        <record id="room_conference" model="virtual.room">
            <field name="name">Conference Room</field>
            <field name="office_id" ref="office_headquarters"/>
            <field name="room_type">conference</field>
            <field name="sequence">3</field>
            <field name="capacity">8</field>
            <field name="pos_x">-7</field>
            <field name="pos_y">4</field>
            <field name="width">8</field>
            <field name="depth">6</field>
            <field name="color">#E67E22</field>
        </record>

        <record id="room_focus_pod" model="virtual.room">
            <field name="name">Focus Pod</field>
            <field name="office_id" ref="office_headquarters"/>
            <field name="room_type">pod</field>
            <field name="sequence">4</field>
            <field name="capacity">4</field>
            <field name="pos_x">2</field>
            <field name="pos_y">4</field>
            <field name="width">5</field>
            <field name="depth">6</field>
            <field name="color">#2ECC71</field>
        </record>

        <record id="room_phone_booth" model="virtual.room">
            <field name="name">Phone Booth</field>
            <field name="office_id" ref="office_headquarters"/>
            <field name="room_type">phone_booth</field>
            <field name="sequence">5</field>
            <field name="capacity">1</field>
            <field name="pos_x">8</field>
            <field name="pos_y">4</field>
            <field name="width">4</field>
            <field name="depth">6</field>
            <field name="color">#9B59B6</field>
        </record>

    </data>

    <data noupdate="1">
        <!-- Mark attendees that stopped heart-beating as offline. -->
        <record id="ir_cron_virtual_office_reap" model="ir.cron">
            <field name="name">Virtual Office: reap stale attendees</field>
            <field name="model_id" ref="model_virtual_attendee"/>
            <field name="state">code</field>
            <field name="code">model._reap_stale()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Purge stale WebRTC signalling envelopes. -->
        <record id="ir_cron_virtual_office_signal_gc" model="ir.cron">
            <field name="name">Virtual Office: purge stale signals</field>
            <field name="model_id" ref="model_virtual_signal"/>
            <field name="state">code</field>
            <field name="code">model._gc()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
