<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_virtual_office" model="ir.module.category">
        <field name="name">Virtual Office</field>
        <field name="description">Access to the 3D virtual office workspace.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_virtual_office_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_virtual_office"/>
        <field name="comment">Can enter virtual offices they are a member of.</field>
    </record>

    <record id="group_virtual_office_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_virtual_office"/>
        <field name="comment">Can create and configure offices, rooms and guest passes.</field>
        <field name="implied_ids" eval="[(4, ref('group_virtual_office_user'))]"/>
    </record>

    <!-- Every internal user can use the virtual office by default. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_virtual_office_user'))]"/>
    </record>

</odoo>
