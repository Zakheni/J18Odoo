<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_product_form_pastel_sync" model="ir.ui.view">
        <field name="name">product.product.form.pastel.sync</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_sync_to_pastel"
                        type="object"
                        class="btn btn-primary"
                        icon="fa-upload"
                        string="Sync to Pastel"
                        groups="base.group_system"/>
                <button name="action_sync_from_pastel"
                        type="object"
                        class="btn btn-secondary"
                        icon="fa-download"
                        string="Sync from Pastel"
                        groups="base.group_system"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="pastel_sync" string="Pastel Sync">
                    <group>
                        <field name="pastel_stock_code"/>
                        <field name="pastel_sync_status" widget="badge"/>
                        <field name="last_pastel_sync_date"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
