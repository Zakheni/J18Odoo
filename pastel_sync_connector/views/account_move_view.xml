<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_pastel_sync" model="ir.ui.view">
        <field name="name">account.move.form.pastel.sync</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_sync_invoice_to_pastel"
                        type="object"
                        class="btn btn-primary"
                        icon="fa-upload"
                        string="Sync to Pastel"
                        groups="account.group_account_invoice,base.group_system"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="pastel_sync" string="Pastel Sync">
                    <group>
                        <field name="pastel_transaction_no"/>
                        <field name="pastel_sync_status" widget="badge"/>
                        <field name="last_pastel_sync_date"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
