<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pastel_sync" model="ir.ui.view">
        <field name="name">res.partner.form.pastel.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_sync_to_pastel"
                        type="object"
                        class="btn btn-primary"
                        icon="fa-upload"
                        string="Sync to Pastel"
                        context="{'sync_direction': 'odoo-to-pastel'}"
                        groups="base.group_system"/>
                <button name="action_sync_from_pastel"
                        type="object"
                        class="btn btn-secondary"
                        icon="fa-download"
                        string="Sync from Pastel"
                        context="{'sync_direction': 'pastel-to-odoo'}"
                        groups="base.group_system"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group name="pastel_sync" string="Pastel Accounting Sync">
                    <field name="pastel_account_code"/>
                    <field name="pastel_sync_status" widget="badge"/>
                    <field name="last_pastel_sync_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
