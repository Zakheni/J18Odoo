<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Sync Action -->
    <record id="action_pastel_sync_wizard" model="ir.actions.act_window">
        <field name="name">Pastel Sync</field>
        <field name="res_model">pastel.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_pastel_sync_log_list" model="ir.actions.act_window">
        <field name="name">Pastel Sync Logs</field>
        <field name="res_model">pastel.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_pastel_sync_root"
              name="Pastel Connector"
              sequence="99"
              groups="base.group_system"/>

    <menuitem id="menu_pastel_sync_run"
              name="Run Pastel Sync"
              parent="menu_pastel_sync_root"
              action="action_pastel_sync_wizard"
              sequence="10"/>

    <menuitem id="menu_pastel_sync_logs"
              name="Sync Logs"
              parent="menu_pastel_sync_root"
              action="action_pastel_sync_log_list"
              sequence="20"/>

    <!-- Wizard Form View -->
    <record id="view_pastel_sync_wizard_form" model="ir.ui.view">
        <field name="name">pastel.sync.wizard.form</field>
        <field name="model">pastel.sync.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="sync_direction"/>
                    <field name="sync_scope"/>
                </group>
                <footer>
                    <button name="action_run_sync"
                            type="object"
                            string="Run Sync"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Log Tree View -->
    <record id="view_pastel_sync_log_tree" model="ir.ui.view">
        <field name="name">pastel.sync.log.tree</field>
        <field name="model">pastel.sync.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                <field name="scope"/>
                <field name="direction"/>
                <field name="return_code"/>
            </list>
        </field>
    </record>

    <!-- Log Form View -->
    <record id="view_pastel_sync_log_form" model="ir.ui.view">
        <field name="name">pastel.sync.log.form</field>
        <field name="model">pastel.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="state" widget="badge"/>
                        <field name="scope"/>
                        <field name="direction"/>
                        <field name="return_code"/>
                    </group>
                    <field name="output" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
