<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mailing_list_form_inherit" model="ir.ui.view">
        <field name="name">mailing.list.form.inherit.zakheni</field>
        <field name="model">mailing.list</field>
        <field name="inherit_id" ref="mass_mailing.mailing_list_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="category"/>
                <field name="description"/>
                <group name="dynamic_sync" string="Dynamic Sync">
                    <field name="is_dynamic"/>
                    <field name="dynamic_model"/>
                    <field name="dynamic_domain"
                        invisible="not is_dynamic" required="is_dynamic"/>
                    <field name="last_sync"/>
                    <button name="action_sync_dynamic_list" string="Sync Now" type="object"
                        class="btn-primary" invisible="not is_dynamic"/>
                </group>
            </field>
        </field>
    </record>
</odoo>
