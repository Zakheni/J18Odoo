<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_segment_tree" model="ir.ui.view">
        <field name="name">marketing.segment.tree</field>
        <field name="model">marketing.segment</field>
        <field name="arch" type="xml">
            <list>
                <field name="color"/>
                <field name="name"/>
                <field name="category"/>
                <field name="condition_type"/>
                <field name="contact_count"/>
                <field name="is_dynamic"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_marketing_segment_form" model="ir.ui.view">
        <field name="name">marketing.segment.form</field>
        <field name="model">marketing.segment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contacts" type="object"
                            class="oe_stat_button" icon="fa-users">
                            <field name="contact_count" widget="statinfo" string="Contacts"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="active"/>
                            <field name="condition_type"/>
                        </group>
                        <group>
                            <field name="model_id"/>
                            <field name="is_dynamic"/>
                            <field name="color"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page name="conditions" string="Conditions">
                            <group name="behavioral"
                                invisible="condition_type not in ('behavioral', 'engagement')">
                                <group string="Engagement">
                                    <field name="min_engagement_score"/>
                                    <field name="max_engagement_score"/>
                                </group>
                                <group string="Lead Score">
                                    <field name="min_lead_score"/>
                                    <field name="max_lead_score"/>
                                </group>
                                <group string="Email Activity">
                                    <field name="min_total_opens"/>
                                    <field name="min_total_clicks"/>
                                    <field name="last_open_within_days"/>
                                    <field name="last_click_within_days"/>
                                </group>
                            </group>
                            <group name="custom_domain"
                                invisible="condition_type != 'custom'">
                                <field name="domain" widget="domain_editor"
                                    options="{'model': 'mailing.contact'}"/>
                            </group>
                        </page>
                        <page name="lists" string="Mailing Lists">
                            <field name="list_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marketing_segment_search" model="ir.ui.view">
        <field name="name">marketing.segment.search</field>
        <field name="model">marketing.segment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Dynamic" name="dynamic"
                    domain="[('is_dynamic','=',True)]"/>
                <filter string="Static" name="static"
                    domain="[('is_dynamic','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category"
                        context="{'group_by':'category'}"/>
                    <filter string="Condition" name="group_condition"
                        context="{'group_by':'condition_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_marketing_segment" model="ir.actions.act_window">
        <field name="name">Segments</field>
        <field name="res_model">marketing.segment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_marketing_segment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first segment</p>
            <p>Define audience segments based on demographics, behavior, and engagement levels for targeted campaigns.</p>
        </field>
    </record>
</odoo>
