<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_landing_page_tree" model="ir.ui.view">
        <field name="name">marketing.landing.page.tree</field>
        <field name="model">marketing.landing.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="page_type"/>
                <field name="url"/>
                <field name="total_views"/>
                <field name="total_submissions"/>
                <field name="conversion_rate" widget="percentpie"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_marketing_landing_page_form" model="ir.ui.view">
        <field name="name">marketing.landing.page.form</field>
        <field name="model">marketing.landing.page</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_page" type="object"
                            class="oe_stat_button" icon="fa-external-link"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="page_type"/>
                            <field name="campaign_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="url"/>
                            <field name="template_id"/>
                            <field name="mailing_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Configuration">
                            <field name="lead_team_id"/>
                            <field name="mailing_list_id"/>
                        </group>
                        <group string="Performance">
                            <field name="total_views"/>
                            <field name="total_submissions"/>
                            <field name="conversion_rate" widget="percentpie"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_marketing_landing_page" model="ir.actions.act_window">
        <field name="name">Landing Pages</field>
        <field name="res_model">marketing.landing.page</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
