<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_reengagement_tree" model="ir.ui.view">
        <field name="name">marketing.reengagement.tree</field>
        <field name="model">marketing.reengagement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="inactivity_days"/>
                <field name="trigger_event"/>
                <field name="max_attempts"/>
                <field name="action_on_failure"/>
                <field name="success_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_marketing_reengagement_form" model="ir.ui.view">
        <field name="name">marketing.reengagement.form</field>
        <field name="model">marketing.reengagement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" string="Run Now" type="object"
                        class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="trigger_event"/>
                            <field name="inactivity_days"/>
                            <field name="max_attempts"/>
                        </group>
                        <group>
                            <field name="segment_id"/>
                            <field name="action_on_failure"/>
                            <field name="target_list_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Results">
                        <field name="success_count"/>
                        <field name="lost_count"/>
                        <field name="last_run"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_marketing_reengagement" model="ir.actions.act_window">
        <field name="name">Re-engagement Campaigns</field>
        <field name="res_model">marketing.reengagement</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a re-engagement campaign</p>
            <p>Win back inactive contacts with automated re-engagement campaigns.</p>
        </field>
    </record>
</odoo>
