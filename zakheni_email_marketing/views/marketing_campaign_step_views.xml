<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_campaign_step_tree" model="ir.ui.view">
        <field name="name">marketing.campaign.step.tree</field>
        <field name="model">marketing.campaign.step</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="trigger_type"/>
                <field name="delay_days"/>
                <field name="action_type"/>
                <field name="mailing_template_id"/>
                <field name="executed_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_marketing_campaign_step_form" model="ir.ui.view">
        <field name="name">marketing.campaign.step.form</field>
        <field name="model">marketing.campaign.step</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="campaign_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="trigger_type"/>
                            <field name="delay_days" invisible="trigger_type != 'delay_after_previous'" required="trigger_type == 'delay_after_previous'"/>
                            <field name="delay_hours" invisible="trigger_type != 'delay_after_previous'"/>
                            <field name="scheduled_date" invisible="trigger_type != 'scheduled'" required="trigger_type == 'scheduled'"/>
                        </group>
                    </group>
                    <group string="Action Configuration">
                        <field name="action_type"/>
                        <field name="mailing_template_id" invisible="action_type not in ('send_mail', 'send_sms', 'both')"/>
                        <field name="mail_server_id" invisible="action_type != 'send_mail'"/>
                        <field name="segment_ids" widget="many2many_tags"/>
                        <field name="lead_score_change" invisible="action_type != 'update_lead_score'"/>
                        <field name="target_segment_id" invisible="action_type not in ('add_to_segment', 'remove_from_segment', 'update_lead_score')"/>
                        <field name="webhook_url" invisible="action_type != 'webhook'"/>
                        <field name="lead_team_id" invisible="action_type != 'create_lead'"/>
                        <field name="lead_user_id" invisible="action_type != 'create_lead'"/>
                    </group>
                    <group string="Execution Stats">
                        <field name="executed_count"/>
                        <field name="success_count"/>
                        <field name="last_execution"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
