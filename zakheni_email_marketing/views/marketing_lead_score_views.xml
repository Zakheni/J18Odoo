<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_lead_score_tree" model="ir.ui.view">
        <field name="name">marketing.lead.score.tree</field>
        <field name="model">marketing.lead.score</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="trigger_event"/>
                <field name="score_change"/>
                <field name="max_score"/>
                <field name="current_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_marketing_lead_score_form" model="ir.ui.view">
        <field name="name">marketing.lead.score.form</field>
        <field name="model">marketing.lead.score</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="trigger_event"/>
                            <field name="score_change"/>
                            <field name="max_score"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_marketing_lead_score" model="ir.actions.act_window">
        <field name="name">Lead Scoring Rules</field>
        <field name="res_model">marketing.lead.score</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
