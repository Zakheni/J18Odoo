<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_process_automated_campaigns" model="ir.cron">
            <field name="name">Marketing: Process Automated Campaigns</field>
            <field name="model_id" ref="model_marketing_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_automated_campaigns()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_process_date_automations" model="ir.cron">
            <field name="name">Marketing: Process Date-Based Automations</field>
            <field name="model_id" ref="model_marketing_automation"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_date_automations()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_process_reengagement" model="ir.cron">
            <field name="name">Marketing: Process Re-engagement Campaigns</field>
            <field name="model_id" ref="model_marketing_reengagement"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_reengagement()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
