<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_za_irp5_wizard" model="ir.ui.view">
        <field name="name">l10n_za.irp5.wizard.form</field>
        <field name="model">l10n_za.irp5.wizard</field>
        <field name="arch" type="xml">
            <form string="SARS IRP5/IT3(a) Certificate">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="tax_year"/>
                    <field name="certificate_type"/>
                    <field name="employee_id" domain="[('company_id', '=', company_id)]"/>
                </group>
                <footer>
                    <button name="action_print_irp5" string="Generate Certificate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_za_irp5" model="ir.actions.act_window">
        <field name="name">IRP5/IT3(a) Certificate</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_za.irp5.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_report_l10n_za_irp5" model="ir.actions.report">
        <field name="name">IRP5/IT3(a) Certificate</field>
        <field name="model">l10n_za.irp5.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_za_hr_payroll.report_irp5</field>
        <field name="report_file">l10n_za_hr_payroll.report_irp5</field>
        <field name="binding_type">report</field>
    </record>
</odoo>
