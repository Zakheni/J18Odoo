<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_za_hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.l10n_za.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group name="l10n_za" string="South African Information">
                    <field name="l10n_za_id_number"/>
                    <field name="l10n_za_tax_number"/>
                    <field name="l10n_za_passport_number"/>
                    <field name="l10n_za_medical_aid_dependents"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
