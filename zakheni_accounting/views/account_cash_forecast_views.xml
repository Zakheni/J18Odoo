<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zakheni_cash_forecast_action" model="ir.actions.act_window">
        <field name="name">Cash Flow Forecast</field>
        <field name="res_model">zakheni.cash.forecast</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_date': 1}</field>
    </record>

    <record id="zakheni_cash_forecast_action_generate" model="ir.actions.server">
        <field name="name">Generate Cash Flow Forecast</field>
        <field name="model_id" ref="model_zakheni_cash_forecast"/>
        <field name="state">code</field>
        <field name="code">model.generate_forecast()</field>
    </record>

    <record id="action_generate_cash_forecast" model="ir.actions.act_window">
        <field name="name">Generate Cash Flow Forecast</field>
        <field name="binding_model_id" ref="model_zakheni_cash_forecast"/>
        <field name="res_model">zakheni.cash.forecast</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="zakheni_cash_forecast_tree" model="ir.ui.view">
        <field name="name">zakheni.cash.forecast.tree</field>
        <field name="model">zakheni.cash.forecast</field>
        <field name="arch" type="xml">
            <list string="Cash Flow Forecast" multi_edit="1">
                <field name="date"/>
                <field name="name"/>
                <field name="forecast_type"/>
                <field name="inflow" widget="monetary" optional="hide"/>
                <field name="outflow" widget="monetary" optional="hide"/>
                <field name="balance" widget="monetary" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="zakheni_cash_forecast_search" model="ir.ui.view">
        <field name="name">zakheni.cash.forecast.search</field>
        <field name="model">zakheni.cash.forecast</field>
        <field name="arch" type="xml">
            <search string="Search Cash Forecast">
                <field name="name"/>
                <field name="forecast_type"/>
                <filter name="group_by_date" string="Group by Date" context="{'group_by': 'date:week'}"/>
                <separator/>
                <filter name="inflow_only" string="Inflow" domain="[('inflow', '>', 0)]"/>
                <filter name="outflow_only" string="Outflow" domain="[('outflow', '>', 0)]"/>
            </search>
        </field>
    </record>
</odoo>
