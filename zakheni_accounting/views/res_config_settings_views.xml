<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zakheni_accounting_res_config_settings" model="ir.ui.view">
        <field name="name">zakheni.accounting.res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Enterprise Accounting" string="Enterprise Accounting" name="zakheni_accounting">
                    <block title="Cash Flow Forecast">
                        <setting>
                            <field name="cash_forecast_days"/>
                        </setting>
                    </block>
                    <block title="Customer Follow-up">
                        <setting>
                            <field name="enable_auto_followup"/>
                        </setting>
                        <setting>
                            <field name="followup_cron_interval"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
