<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zakheni_followup_plan_tree" model="ir.ui.view">
        <field name="name">zakheni.followup.plan.tree</field>
        <field name="model">zakheni.followup.plan</field>
        <field name="arch" type="xml">
            <list string="Follow-up Plans" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="zakheni_followup_plan_form" model="ir.ui.view">
        <field name="name">zakheni.followup.plan.form</field>
        <field name="model">zakheni.followup.plan</field>
        <field name="arch" type="xml">
            <form string="Follow-up Plan">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Levels">
                            <field name="level_ids">
                                <list editable="bottom" multi_edit="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="days_offset"/>
                                    <field name="send_email"/>
                                    <field name="send_letter"/>
                                    <field name="manual_action"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zakheni_followup_plan_action" model="ir.actions.act_window">
        <field name="name">Follow-up Plans</field>
        <field name="res_model">zakheni.followup.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
