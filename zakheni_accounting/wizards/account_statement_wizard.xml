<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_statement_wizard_form" model="ir.ui.view">
        <field name="name">zakheni.account.statement.wizard.form</field>
        <field name="model">zakheni.account.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Statement">
                <group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="statement_type"/>
                        <field name="min_days_overdue"/>
                        <field name="include_aging"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button name="action_send" string="Send by Email" type="object" class="btn-secondary"/>
                    <button special="cancel" string="Cancel" class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_statement_wizard" model="ir.actions.act_window">
        <field name="name">Customer Statement</field>
        <field name="res_model">zakheni.account.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
