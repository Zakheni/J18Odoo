<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="followup_plan_standard" model="zakheni.followup.plan">
        <field name="name">Standard Follow-up Plan</field>
        <field name="sequence">10</field>
    </record>

    <record id="followup_level_1" model="zakheni.followup.level">
        <field name="plan_id" ref="followup_plan_standard"/>
        <field name="name">Level 1 - Friendly Reminder</field>
        <field name="days_offset">0</field>
        <field name="sequence">10</field>
        <field name="send_email" eval="True"/>
        <field name="send_letter" eval="False"/>
    </record>

    <record id="followup_level_2" model="zakheni.followup.level">
        <field name="plan_id" ref="followup_plan_standard"/>
        <field name="name">Level 2 - Second Notice</field>
        <field name="days_offset">7</field>
        <field name="sequence">20</field>
        <field name="send_email" eval="True"/>
        <field name="send_letter" eval="False"/>
    </record>

    <record id="followup_level_3" model="zakheni.followup.level">
        <field name="plan_id" ref="followup_plan_standard"/>
        <field name="name">Level 3 - Final Notice</field>
        <field name="days_offset">14</field>
        <field name="sequence">30</field>
        <field name="send_email" eval="True"/>
        <field name="send_letter" eval="True"/>
    </record>

    <record id="followup_level_4" model="zakheni.followup.level">
        <field name="plan_id" ref="followup_plan_standard"/>
        <field name="name">Level 4 - Escalated to Collections</field>
        <field name="days_offset">30</field>
        <field name="sequence">40</field>
        <field name="manual_action" eval="True"/>
    </record>
</odoo>
