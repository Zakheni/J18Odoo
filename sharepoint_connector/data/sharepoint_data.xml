<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_sharepoint_sync" model="ir.cron">
        <field name="name">SharePoint: Sync document libraries</field>
        <field name="model_id" ref="model_sharepoint_document_library"/>
        <field name="state">code</field>
        <field name="code">model._run_scheduled_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

    <record id="cron_sharepoint_list_sync" model="ir.cron">
        <field name="name">SharePoint: Sync lists</field>
        <field name="model_id" ref="model_sharepoint_list"/>
        <field name="state">code</field>
        <field name="code">model._run_scheduled_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
