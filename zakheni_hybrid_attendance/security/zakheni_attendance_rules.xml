<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zakheni_attendance_day_own_rule" model="ir.rule">
        <field name="name">Daily records: users see only their own</field>
        <field name="model_id" ref="model_zakheni_attendance_day"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="zakheni_attendance_day_manager_rule" model="ir.rule">
        <field name="name">Daily records: managers see all</field>
        <field name="model_id" ref="model_zakheni_attendance_day"/>
        <field name="groups" eval="[(4, ref('zakheni_hybrid_attendance.group_zakheni_attendance_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>