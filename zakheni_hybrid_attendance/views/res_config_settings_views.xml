<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zakheni_res_config_settings_attendance" model="ir.ui.view">
        <field name="name">ResConfigSettings hybrid attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="Hybrid Attendance">
                    <setting string="Late Grace (minutes)" company_dependent="1"
                        help="Employees checking in more than this many minutes after their scheduled start time are flagged as late.">
                        <field name="zakheni_late_grace_minutes" class="text-center" style="width: 6ch;"/><span class="ms-2">Minutes</span>
                    </setting>
                    <setting string="Auto-Approve Daily Records" company_dependent="1"
                        help="Daily work records with no exceptions are approved automatically at the end of the day.">
                        <field name="zakheni_auto_approve_daily"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>