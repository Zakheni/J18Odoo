<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zakheni_resource_calendar_attendance_tree" model="ir.ui.view">
        <field name="name">resource.calendar.attendance.tree (hybrid)</field>
        <field name="model">resource.calendar.attendance</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hour_to']" position="after">
                <field name="work_location_id" optional="show" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="zakheni_resource_calendar_attendance_form" model="ir.ui.view">
        <field name="name">resource.calendar.attendance.form (hybrid)</field>
        <field name="model">resource.calendar.attendance</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_attendance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hour_to']" position="after">
                <field name="work_location_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Standalone view (list editable) used when opening a schedule directly -->
    <record id="zakheni_resource_calendar_attendance_action" model="ir.actions.act_window">
        <field name="name">Work Schedule Lines</field>
        <field name="res_model">resource.calendar.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="zakheni_resource_calendar_attendance_tree"/>
    </record>

</odoo>