<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Bulk Status Update Wizard -->
    <record id="view_asset_bulk_update_wizard_form" model="ir.ui.view">
        <field name="name">asset.bulk.update.wizard.form</field>
        <field name="model">asset.bulk.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Assets">
                <group>
                    <field name="asset_ids" invisible="1"/>
                    <field name="status" widget="statusbar"
                        options="{'statusbar_visible': 'draft,in_use,maintenance,disposed'}"/>
                    <field name="current_location_id"/>
                    <field name="assigned_employee_id"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_bulk_update" model="ir.actions.act_window">
        <field name="name">Update Status</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">asset.bulk.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server action: Bulk Update Status (opens wizard) -->
    <record id="action_server_bulk_status_update" model="ir.actions.server">
        <field name="name">Update Status</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="binding_model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_update_status()</field>
    </record>

    <!-- Server action: Generate QR Codes for selected assets -->
    <record id="action_server_generate_qr" model="ir.actions.server">
        <field name="name">Generate QR Code</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="binding_model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">records._generate_qr_code()</field>
    </record>

    <!-- Server action: Generate QR Codes for all assets missing QR -->
    <record id="action_server_generate_qr_all" model="ir.actions.server">
        <field name="name">Generate QR Codes for All Assets</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">env['asset.asset']._init_qr_codes()</field>
    </record>

    <!-- Menu item for Generate All QR Codes -->
    <menuitem id="menu_generate_qr_all"
        name="Generate All QR Codes"
        parent="zakheni_asset_management.menu_asset_configuration"
        sequence="90"
        action="action_server_generate_qr_all"/>

    <!-- Add "Generate QR Code" button to asset form header -->
    <record id="asset_asset_form_view_inherit_qr" model="ir.ui.view">
        <field name="name">asset.asset.form.inherit.qr</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="zakheni_asset_management.asset_asset_form"/>
        <field name="arch" type="xml">
            <button name="action_print_qr_label" position="before">
                <button name="action_generate_qr_now" type="object"
                    string="Regenerate QR"
                    class="btn-secondary"
                    invisible="qr_code == False"/>
            </button>
        </field>
    </record>

</odoo>
