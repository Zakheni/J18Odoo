<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default lifecycle stages -->
        <record id="asset_status_draft" model="asset.asset.status">
            <field name="name">Draft</field>
            <field name="code">draft</field>
            <field name="sequence">10</field>
            <field name="fold">True</field>
        </record>
        <record id="asset_status_in_use" model="asset.asset.status">
            <field name="name">In Use</field>
            <field name="code">in_use</field>
            <field name="sequence">20</field>
        </record>
        <record id="asset_status_maintenance" model="asset.asset.status">
            <field name="name">Under Maintenance</field>
            <field name="code">maintenance</field>
            <field name="sequence">30</field>
        </record>
        <record id="asset_status_disposed" model="asset.asset.status">
            <field name="name">Disposed</field>
            <field name="code">disposed</field>
            <field name="sequence">40</field>
            <field name="fold">True</field>
        </record>

        <!-- Default categories -->
        <record id="asset_cat_it" model="asset.category">
            <field name="name">IT Equipment</field>
            <field name="code">IT</field>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">36</field>
            <field name="salvage_value_percent">10.0</field>
        </record>
        <record id="asset_cat_it_laptop" model="asset.category">
            <field name="name">Laptops</field>
            <field name="code">IT-LAP</field>
            <field name="parent_id" ref="asset_cat_it"/>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">36</field>
            <field name="salvage_value_percent">10.0</field>
        </record>
        <record id="asset_cat_it_thin_client" model="asset.category">
            <field name="name">Thin Clients</field>
            <field name="code">IT-TC</field>
            <field name="parent_id" ref="asset_cat_it"/>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">36</field>
            <field name="salvage_value_percent">5.0</field>
        </record>
        <record id="asset_cat_it_desktop" model="asset.category">
            <field name="name">Desktops</field>
            <field name="code">IT-DSK</field>
            <field name="parent_id" ref="asset_cat_it"/>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">48</field>
            <field name="salvage_value_percent">10.0</field>
        </record>
        <record id="asset_cat_it_printer" model="asset.category">
            <field name="name">Printers</field>
            <field name="code">IT-PRN</field>
            <field name="parent_id" ref="asset_cat_it"/>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">36</field>
            <field name="salvage_value_percent">10.0</field>
        </record>
        <record id="asset_cat_it_server" model="asset.category">
            <field name="name">Servers &amp; Networking</field>
            <field name="code">IT-SRV</field>
            <field name="parent_id" ref="asset_cat_it"/>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">60</field>
            <field name="salvage_value_percent">10.0</field>
        </record>
        <record id="asset_cat_it_peripheral" model="asset.category">
            <field name="name">Peripherals</field>
            <field name="code">IT-PER</field>
            <field name="parent_id" ref="asset_cat_it"/>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">24</field>
            <field name="salvage_value_percent">5.0</field>
        </record>
        <record id="asset_cat_furniture" model="asset.category">
            <field name="name">Furniture &amp; Fixtures</field>
            <field name="code">FURN</field>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">60</field>
            <field name="salvage_value_percent">5.0</field>
        </record>
        <record id="asset_cat_vehicle" model="asset.category">
            <field name="name">Vehicles</field>
            <field name="code">VEH</field>
            <field name="depreciation_method">reducing_balance</field>
            <field name="depreciation_duration_months">60</field>
            <field name="salvage_value_percent">20.0</field>
        </record>
        <record id="asset_cat_building" model="asset.category">
            <field name="name">Buildings &amp; Property</field>
            <field name="code">BLDG</field>
            <field name="depreciation_method">straight_line</field>
            <field name="depreciation_duration_months">240</field>
            <field name="salvage_value_percent">20.0</field>
        </record>

        <!-- Default locations -->
        <record id="asset_loc_head_office" model="asset.location">
            <field name="name">Head Office</field>
            <field name="code">HQ</field>
        </record>
        <record id="asset_loc_warehouse" model="asset.location">
            <field name="name">Main Warehouse</field>
            <field name="code">WH</field>
        </record>
    </data>
</odoo>
