<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="portal_create_ticket_public_fields"
        inherit_id="helpdesk_mgmt.portal_create_ticket"
        name="Add name/email fields for public users"
    >
        <!-- Add name field after CSRF token for public users -->
        <xpath expr="//form/input[@name='csrf_token']" position="after">
            <div t-if="is_public" class="form-group mb-3">
                <label class="col-md-3 col-sm-4 control-label" for="partner_name">Your Name</label>
                <div class="col-md-7 col-sm-8">
                    <input type="text" class="form-control" name="partner_name" required="True" t-att-value="name" />
                </div>
            </div>
            <div t-if="is_public" class="form-group mb-3">
                <label class="col-md-3 col-sm-4 control-label" for="partner_email">Your Email</label>
                <div class="col-md-7 col-sm-8">
                    <input type="email" class="form-control" name="partner_email" required="True" t-att-value="email" />
                </div>
            </div>
        </xpath>
        <!-- Replace form tag with t-if wrapper for success state -->
        <xpath expr="//form" position="attributes">
            <attribute name="t-if">not success</attribute>
        </xpath>
        <!-- Add success message before form -->
        <xpath expr="//form" position="before">
            <div t-if="success" class="alert alert-success mx-3 mt16" role="alert">
                <strong>Ticket submitted!</strong> Your ticket <t t-esc="ticket_ref" /> has been received. We will contact you as soon as possible.
            </div>
        </xpath>
    </template>
</odoo>
