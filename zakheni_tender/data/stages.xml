<odoo noupdate="1">
    <record id="stage_identified" model="tender.stage">
        <field name="name">Identified</field>
        <field name="sequence">10</field>
        <field name="probability">5</field>
        <field name="description">Tender opportunity identified. Initial review pending.</field>
    </record>
    <record id="stage_reviewing" model="tender.stage">
        <field name="name">Reviewing</field>
        <field name="sequence">20</field>
        <field name="probability">15</field>
        <field name="description">Evaluating RFP documents and deciding whether to bid.</field>
    </record>
    <record id="stage_preparing" model="tender.stage">
        <field name="name">Preparing</field>
        <field name="sequence">30</field>
        <field name="probability">30</field>
        <field name="description">Proposal is being drafted and documents are being gathered.</field>
    </record>
    <record id="stage_submitted" model="tender.stage">
        <field name="name">Submitted</field>
        <field name="sequence">40</field>
        <field name="probability">50</field>
        <field name="description">Bid has been submitted before the deadline.</field>
    </record>
    <record id="stage_evaluation" model="tender.stage">
        <field name="name">Under Evaluation</field>
        <field name="sequence">50</field>
        <field name="probability">60</field>
        <field name="description">Issuer is evaluating all submitted bids.</field>
    </record>
    <record id="stage_won" model="tender.stage">
        <field name="name">Won</field>
        <field name="sequence">60</field>
        <field name="probability">100</field>
        <field name="fold">1</field>
        <field name="is_won">1</field>
        <field name="description">Contract awarded to us.</field>
    </record>
    <record id="stage_lost" model="tender.stage">
        <field name="name">Lost</field>
        <field name="sequence">70</field>
        <field name="probability">0</field>
        <field name="fold">1</field>
        <field name="is_lost">1</field>
        <field name="description">Bid unsuccessful.</field>
    </record>
</odoo>
