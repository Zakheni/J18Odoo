<odoo>
    <record id="tender_feed_keyword_config_tree" model="ir.ui.view">
        <field name="name">tender.feed.keyword.config.tree</field>
        <field name="model">tender.feed.keyword.config</field>
        <field name="arch" type="xml">
            <list string="Keyword Configs" multi_edit="1">
                <field name="name"/>
                <field name="keywords"/>
                <field name="profile_id"/>
                <field name="min_days_to_deadline" optional="show"/>
                <field name="feed_count"/>
                <field name="last_fetch_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="tender_feed_keyword_config_form" model="ir.ui.view">
        <field name="name">tender.feed.keyword.config.form</field>
        <field name="model">tender.feed.keyword.config</field>
        <field name="arch" type="xml">
            <form string="Keyword Config">
                <header>
                    <button name="action_run_now" type="object" string="Run Now"
                            class="btn-primary"/>
                    <button name="action_view_feeds" type="object" string="View Matched Feeds"
                            class="btn-info"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="keywords" placeholder="e.g. IT, Software, Technology"/>
                            <field name="profile_id"/>
                            <field name="min_days_to_deadline"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="last_fetch_date"/>
                            <field name="feed_count"/>
                        </group>
                    </group>
                    <field name="feed_ids" readonly="1">
                        <list string="Matched Feeds">
                            <field name="name"/>
                            <field name="ocds_category"/>
                            <field name="deadline_submission"/>
                            <field name="status"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tender_feed_keyword_config_action" model="ir.actions.act_window">
        <field name="name">Preconfigured Keywords</field>
        <field name="res_model">tender.feed.keyword.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
