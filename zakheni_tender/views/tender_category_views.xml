<odoo>
    <record id="tender_category_form" model="ir.ui.view">
        <field name="name">tender.tender.category.form</field>
        <field name="model">tender.tender.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tender_category_tree" model="ir.ui.view">
        <field name="name">tender.tender.category.tree</field>
        <field name="model">tender.tender.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="tender_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">tender.tender.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
