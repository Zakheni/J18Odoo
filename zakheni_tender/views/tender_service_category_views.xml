<odoo>
    <record id="tender_service_category_tree" model="ir.ui.view">
        <field name="name">tender.service.category.tree</field>
        <field name="model">tender.service.category</field>
        <field name="arch" type="xml">
            <list string="Service Categories" multi_edit="1">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="tender_service_category_form" model="ir.ui.view">
        <field name="name">tender.service.category.form</field>
        <field name="model">tender.service.category</field>
        <field name="arch" type="xml">
            <form string="Service Category">
                <header>
                    <button name="action_search_etenders" type="object" string="Search on eTenders"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="ocds_keywords"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tender_service_category_search" model="ir.ui.view">
        <field name="name">tender.service.category.search</field>
        <field name="model">tender.service.category</field>
        <field name="arch" type="xml">
            <search string="Search Service Categories">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="tender_service_category_action" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">tender.service.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="tender_service_category_search"/>
    </record>
</odoo>
