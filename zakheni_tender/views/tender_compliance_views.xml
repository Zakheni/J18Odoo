<odoo>
    <record id="tender_compliance_checklist_form" model="ir.ui.view">
        <field name="name">tender.compliance.checklist.form</field>
        <field name="model">tender.compliance.checklist</field>
        <field name="arch" type="xml">
            <form string="Compliance Checklist">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="category_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="description" nolabel="1"/>
                    <notebook>
                        <page string="Requirements">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="document_required"/>
                                    <field name="description"/>
                                    <field name="help_text"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tender_compliance_checklist_tree" model="ir.ui.view">
        <field name="name">tender.compliance.checklist.tree</field>
        <field name="model">tender.compliance.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="tender_compliance_checklist_action" model="ir.actions.act_window">
        <field name="name">Compliance Checklists</field>
        <field name="res_model">tender.compliance.checklist</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="tender_compliance_result_form" model="ir.ui.view">
        <field name="name">tender.compliance.result.form</field>
        <field name="model">tender.compliance.result</field>
        <field name="arch" type="xml">
            <form string="Compliance Result">
                <sheet>
                    <group>
                        <group>
                            <field name="tender_id"/>
                            <field name="checklist_id"/>
                        </group>
                        <group>
                            <field name="completed_items"/>
                            <field name="total_items"/>
                            <field name="compliance_percent" widget="percentage"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="top">
                            <field name="name"/>
                            <field name="required"/>
                            <field name="document_required"/>
                            <field name="is_compliant"/>
                            <field name="notes"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tender_compliance_result_action" model="ir.actions.act_window">
        <field name="name">Compliance Results</field>
        <field name="res_model">tender.compliance.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
