<odoo>
    <record id="tender_tender_tree" model="ir.ui.view">
        <field name="name">tender.tender.tree</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <list string="Tenders">
                <field name="display_name" invisible="1"/>
                <field name="tender_number"/>
                <field name="name"/>
                <field name="issuer_id"/>
                <field name="stage_id"/>
                <field name="user_id"/>
                <field name="deadline_submission"/>
                <field name="tender_value" optional="show"/>
                <field name="quoted_amount" optional="show"/>
                <field name="probability" optional="show"/>
                <field name="result" optional="show"/>
            </list>
        </field>
    </record>

    <record id="tender_tender_kanban" model="ir.ui.view">
        <field name="name">tender.tender.kanban</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="color"/>
                <field name="display_name"/>
                <field name="issuer_id"/>
                <field name="deadline_submission"/>
                <field name="tender_value"/>
                <field name="quoted_amount"/>
                <field name="probability"/>
                <field name="stage_id"/>
                <field name="document_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_kanban_card {{kanban_color(color)}}">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="display_name"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <span class="text-muted">Issuer:</span>
                                        <field name="issuer_id"/>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">Deadline:</span>
                                        <field name="deadline_submission" widget="remaining_days"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <span class="text-muted">Value:</span>
                                        <field name="tender_value" widget="monetary"/>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">Prob:</span>
                                        <field name="probability" widget="percentage"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <field name="document_count"/>
                                        <span t-if="record.document_count.raw_value > 0"> document(s)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="user_id" avatar="user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="tender_tender_search" model="ir.ui.view">
        <field name="name">tender.tender.search</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <search string="Search Tenders">
                <field name="name"/>
                <field name="tender_number"/>
                <field name="issuer_id"/>
                <filter name="stage" string="Stage" context="{'group_by':'stage_id'}"/>
                <filter name="user" string="Responsible" context="{'group_by':'user_id'}"/>
                <filter name="result" string="Result" context="{'group_by':'result'}"/>
            </search>
        </field>
    </record>

    <record id="tender_tender_graph" model="ir.ui.view">
        <field name="name">tender.tender.graph</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <graph string="Tender Analysis">
                <field name="user_id" type="row"/>
                <field name="tender_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="tender_tender_pivot" model="ir.ui.view">
        <field name="name">tender.tender.pivot</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <pivot string="Tender Pivot">
                <field name="user_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="tender_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="tender_tender_form" model="ir.ui.view">
        <field name="name">tender.tender.form</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <form string="Tender">
                <header>
                    <button name="action_won" type="object" string="Mark Won" class="btn-success"
                            invisible="result != False or stage_id.is_won == True"/>
                    <button name="action_lost" type="object" string="Mark Lost" class="btn-danger"
                            invisible="result != False or stage_id.is_lost == True"/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            invisible="result != False"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-pdf-o">
                            <div class="o_stat_info">
                                <field name="document_count"/>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tender_number"/>
                            <field name="issuer_id" context="{'create': True}"/>
                            <field name="user_id"/>
                            <field name="team_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="stage_id"/>
                            <field name="probability" widget="percentage"/>
                            <field name="competitive_bidding"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Scope of work, requirements, conditions..."/>
                        </page>
                        <page string="Timeline">
                            <group>
                                <group>
                                    <field name="date_published"/>
                                    <field name="date_site_visit"/>
                                    <field name="date_briefing"/>
                                </group>
                                <group>
                                    <field name="preparation_deadline"/>
                                    <field name="deadline_submission"/>
                                    <field name="deadline_validity"/>
                                    <field name="date_submitted"/>
                                    <field name="date_award"/>
                                </group>
                            </group>
                        </page>
                        <page string="Financial">
                            <group>
                                <group>
                                    <field name="tender_value"/>
                                    <field name="quoted_amount"/>
                                    <field name="estimated_bid_cost"/>
                                </group>
                                <group>
                                    <field name="bid_bond_amount"/>
                                    <field name="bid_bond_expiry"/>
                                    <field name="bid_bond_bank"/>
                                </group>
                            </group>
                        </page>
                        <page string="Result" invisible="result == False">
                            <group>
                                <group>
                                    <field name="result"/>
                                    <field name="result_date"/>
                                </group>
                                <group>
                                    <field name="competitor_ids" widget="many2many_tags"
                                            invisible="result != 'lost'"/>
                                    <field name="lost_reason"
                                            invisible="result != 'lost'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tender_tender_action" model="ir.actions.act_window">
        <field name="name">Tenders</field>
        <field name="res_model">tender.tender</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="tender_tender_search"/>
    </record>
</odoo>
