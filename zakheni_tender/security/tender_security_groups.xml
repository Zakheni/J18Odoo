<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="module_category_tender" model="ir.module.category">
            <field name="name">Tender</field>
            <field name="description">Tender Management</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_tender_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_tender"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_tender_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_tender"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
