<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cv_studio" model="ir.module.category">
        <field name="name">CV Studio</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_cv_studio_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_cv_studio"/>
    </record>

    <record id="group_cv_studio_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_cv_studio"/>
        <field name="implied_ids" eval="[(4, ref('group_cv_studio_user'))]"/>
    </record>
</odoo>
