<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zakheni_partner_enrich_settings" model="ir.ui.view">
        <field name="name">zakheni.partner.enrich.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Partner Enrich" string="Partner Enrich" name="zakheni_partner_enrich">
                    <block title="Google Custom Search Configuration">
                        <setting help="Get a free API key at https://console.cloud.google.com/apis/credentials (enable Custom Search API).">
                            <field name="google_api_key" required="True"/>
                        </setting>
                        <setting help="Create a Search Engine at https://programmablesearchengine.google.com/ (set 'Search the entire web' as the site to search).">
                            <field name="google_cx" required="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
