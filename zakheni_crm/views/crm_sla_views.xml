<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_sla_tree" model="ir.ui.view">
        <field name="name">crm.sla.tree</field>
        <field name="model">crm.sla</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active"/>
                <field name="stage_id"/>
                <field name="team_id"/>
                <field name="priority"/>
                <field name="hours"/>
                <field name="success_count"/>
                <field name="breach_count"/>
                <field name="sla_percentage" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="view_crm_sla_form" model="ir.ui.view">
        <field name="name">crm.sla.form</field>
        <field name="model">crm.sla</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="hours"/>
                        </group>
                        <group>
                            <field name="stage_id"/>
                            <field name="team_id"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <group string="Performance">
                        <group>
                            <field name="success_count"/>
                            <field name="breach_count"/>
                        </group>
                        <group>
                            <field name="sla_percentage" widget="percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_sla" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">crm.sla</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
