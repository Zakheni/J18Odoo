<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_grade_tree" model="ir.ui.view">
        <field name="name">crm.lead.grade.tree</field>
        <field name="model">crm.lead.grade</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="min_score"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
                <field name="lead_count"/>
            </list>
        </field>
    </record>

    <record id="view_crm_lead_grade_form" model="ir.ui.view">
        <field name="name">crm.lead.grade.form</field>
        <field name="model">crm.lead.grade</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="min_score"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_grade" model="ir.actions.act_window">
        <field name="name">Lead Grades</field>
        <field name="res_model">crm.lead.grade</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
