<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_competitor_tree" model="ir.ui.view">
        <field name="name">crm.competitor.tree</field>
        <field name="model">crm.competitor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="website"/>
                <field name="active"/>
                <field name="lead_count" string="Deals"/>
            </list>
        </field>
    </record>

    <record id="view_crm_competitor_form" model="ir.ui.view">
        <field name="name">crm.competitor.form</field>
        <field name="model">crm.competitor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="website"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_description"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="strengths" string="Strengths">
                            <field name="strength_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page name="weaknesses" string="Weaknesses">
                            <field name="weakness_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page name="deals" string="Deals">
                            <field name="lead_ids" nolabel="1"
                                context="{'active_test': False}">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="expected_revenue"/>
                                    <field name="probability"/>
                                    <field name="stage_id"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_competitor" model="ir.actions.act_window">
        <field name="name">Competitors</field>
        <field name="res_model">crm.competitor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
