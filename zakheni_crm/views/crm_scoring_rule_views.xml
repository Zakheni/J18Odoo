<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_scoring_rule_tree" model="ir.ui.view">
        <field name="name">crm.scoring.rule.tree</field>
        <field name="model">crm.scoring.rule</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
                <field name="category"/>
                <field name="apply_on"/>
                <field name="operator"/>
                <field name="value"/>
                <field name="score"/>
            </list>
        </field>
    </record>

    <record id="view_crm_scoring_rule_form" model="ir.ui.view">
        <field name="name">crm.scoring.rule.form</field>
        <field name="model">crm.scoring.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="toggle_active" type="object"
                        invisible="active == False"
                        string="Archive" icon="fa-archive"/>
                    <button name="toggle_active" type="object"
                        invisible="active == True"
                        string="Restore" icon="fa-refresh"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                        invisible="active == True"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="category"/>
                            <field name="score"/>
                        </group>
                        <group>
                            <field name="apply_on"/>
                            <field name="operator"/>
                            <field name="value"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_scoring_rule_search" model="ir.ui.view">
        <field name="name">crm.scoring.rule.search</field>
        <field name="model">crm.scoring.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category"/>
                <field name="apply_on"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_crm_scoring_rule" model="ir.actions.act_window">
        <field name="name">Scoring Rules</field>
        <field name="res_model">crm.scoring.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_scoring_rule_search"/>
    </record>
</odoo>
