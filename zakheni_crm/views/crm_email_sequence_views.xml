<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_email_sequence_tree" model="ir.ui.view">
        <field name="name">crm.email.sequence.tree</field>
        <field name="model">crm.email.sequence</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="trigger"/>
                <field name="lead_count"/>
            </list>
        </field>
    </record>

    <record id="view_crm_email_sequence_form" model="ir.ui.view">
        <field name="name">crm.email.sequence.form</field>
        <field name="model">crm.email.sequence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="trigger"/>
                            <field name="trigger_stage_id"
                                invisible="trigger != 'stage_entered'"/>
                        </group>
                    </group>
                    <group string="Email Steps">
                        <field name="step_ids" nolabel="1">
                            <list editable="bottom" create="1" delete="1">
                                <field name="sequence" widget="handle"/>
                                <field name="delay_days"/>
                                <field name="email_template_id"/>
                                <field name="subject"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_email_sequence" model="ir.actions.act_window">
        <field name="name">Email Sequences</field>
        <field name="res_model">crm.email.sequence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
