<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_forecast_tree" model="ir.ui.view">
        <field name="name">crm.forecast.tree</field>
        <field name="model">crm.forecast</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="pipeline_count"/>
                <field name="optimistic_amount" widget="monetary" sum="Total"/>
                <field name="most_likely_amount" widget="monetary" sum="Total"/>
                <field name="pessimistic_amount" widget="monetary" sum="Total"/>
                <field name="weighted_amount" widget="monetary" sum="Total"/>
                <field name="won_amount" widget="monetary" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_crm_forecast_form" model="ir.ui.view">
        <field name="name">crm.forecast.form</field>
        <field name="model">crm.forecast</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Forecast Parameters">
                        <group>
                            <field name="name"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="territory_id"/>
                        </group>
                    </group>
                    <group string="Forecast Results">
                        <group>
                            <field name="pipeline_count" string="Pipeline Opportunities"/>
                            <field name="optimistic_amount" widget="monetary"/>
                            <field name="most_likely_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="pessimistic_amount" widget="monetary"/>
                            <field name="weighted_amount" widget="monetary"/>
                            <field name="won_amount" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_forecast_search" model="ir.ui.view">
        <field name="name">crm.forecast.search</field>
        <field name="model">crm.forecast</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="territory_id"/>
                <filter name="current" string="Current" domain="[('date_end', '>=', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <record id="action_crm_forecast" model="ir.actions.act_window">
        <field name="name">Forecasts</field>
        <field name="res_model">crm.forecast</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
