<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_crm_score_manager" model="res.groups">
        <field name="name">Scoring Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="group_crm_forecast_manager" model="res.groups">
        <field name="name">Forecast Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="group_crm_territory_manager" model="res.groups">
        <field name="name">Territory Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="crm_rule_personal_score" model="ir.rule">
        <field name="name">Personal Lead Scores</field>
        <field name="model_id" ref="model_crm_lead_score"/>
        <field name="domain_force">[('lead_id.user_id', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="crm_rule_all_score" model="ir.rule">
        <field name="name">All Lead Scores (Manager)</field>
        <field name="model_id" ref="model_crm_lead_score"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
