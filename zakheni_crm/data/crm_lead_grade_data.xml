<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lead_grade_a" model="crm.lead.grade">
        <field name="name">Hot Lead</field>
        <field name="code">A</field>
        <field name="min_score">80</field>
        <field name="color">10</field>
        <field name="sequence">10</field>
        <field name="description">High-value, high-intent lead. Immediate follow-up required.</field>
    </record>

    <record id="lead_grade_b" model="crm.lead.grade">
        <field name="name">Warm Lead</field>
        <field name="code">B</field>
        <field name="min_score">50</field>
        <field name="color">3</field>
        <field name="sequence">20</field>
        <field name="description">Good prospect with clear interest. Nurture with targeted content.</field>
    </record>

    <record id="lead_grade_c" model="crm.lead.grade">
        <field name="name">Cold Lead</field>
        <field name="code">C</field>
        <field name="min_score">20</field>
        <field name="color">8</field>
        <field name="sequence">30</field>
        <field name="description">Some interest shown but needs more engagement to qualify.</field>
    </record>

    <record id="lead_grade_d" model="crm.lead.grade">
        <field name="name">Unqualified</field>
        <field name="code">D</field>
        <field name="min_score">0</field>
        <field name="color">5</field>
        <field name="sequence">40</field>
        <field name="description">Low fit or engagement. Consider removing from active pipeline.</field>
    </record>
</odoo>
